@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<https://duffrecords.com/>
    a foaf:Person ;
    foaf:name "Ian Young" ;
    foaf:mbox <mailto:ian@duffrecords.com> ;
    foaf:homepage <https://duffrecords.com/> .

@prefix mellotron: <https://github.com/duffrecords/mellotron#> .

mellotron:ui
    a ui:X11UI ;
    opts:supportedOption <http://lv2plug.in/ns/extensions/ui#scaleFactor> ;
    opts:requiredOption <http://lv2plug.in/ns/extensions/ui#updateRate> ;
    lv2:optionalFeature opts:options ;
    lv2:requiredFeature ui:idleInterface; lv2:extensionData ui:idleInterface;
    lv2:requiredFeature urid:map ;
    .

<https://github.com/duffrecords/mellotron>
    a lv2:Plugin ,
    lv2:InstrumentPlugin ;
    doap:maintainer <https://duffrecords.com/> ;
    doap:name "Mellotron" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:project <https://github.com/duffrecords/mellotron> ;
    lv2:microVersion 0 ; lv2:minorVersion 0 ;
    # lv2:requiredFeature urid:map , lv2:inPlaceBroken ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature urid:map ;
    lv2:requiredFeature opts:options ;
    opts:requiredOption <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ;
    ui:ui mellotron:ui ;
    lv2:port [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "enabled" ;
        lv2:name "Enable" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:toggled;
        lv2:designation lv2:enabled;
    ] , [
        a lv2:AudioPort ,
            lv2:OutputPort ;
            lv2:index 1 ;
            lv2:symbol "output" ;
            lv2:name "Out" ;
    ] , [
        a lv2:InputPort ,
                lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        units:unit units:pc ;
        lv2:scalePoint [
                rdfs:label "B" ;
                rdf:value 1.0
        ] , [
                rdfs:label "" ;
                rdf:value 0.5
        ] , [
                rdfs:label "A" ;
                rdf:value 0.0
        ]
    ] , [
        a atom:AtomPort , lv2:InputPort ;
        atom:bufferType atom:Sequence ;
        lv2:designation lv2:control ;
        atom:supports patch:Message, midi:MidiEvent ;
        lv2:index 3 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
    ], [
        a atom:AtomPort , lv2:OutputPort ;
        atom:bufferType atom:Sequence ;
        lv2:designation lv2:control ;
        lv2:index 4 ;
        lv2:symbol "notify" ;
        lv2:name "Notify" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "level" ;
        lv2:name "Output Level" ;
        lv2:default -6.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum 20.0;
        units:unit units:db ;
    ] .